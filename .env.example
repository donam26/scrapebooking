# dev | staging | prod. prod: api/scheduler từ chối khởi động với JWT_SECRET mặc định, COOKIE_SECURE=false…
APP_ENV=dev

# ---- Secret cho docker compose (bắt buộc: compose dừng nếu thiếu). Giá trị dưới chỉ để phát triển
# cục bộ; máy chủ thật dùng chuỗi ngẫu nhiên dài, chỉ chữ+số (mật khẩu nằm trong URL kết nối). ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=scrapebooking
REDIS_PASSWORD=devredis
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
GRAFANA_ADMIN_PASSWORD=admin
# Caddy (cổng 80/443 duy nhất ra ngoài): ":80" chạy HTTP cục bộ; tên miền (vd ota.congty.vn) để
# Caddy tự lấy TLS Let's Encrypt — khi đó COOKIE_SECURE=true, APP_BASE_URL/CORS_ORIGINS=https://…
SITE_ADDRESS=:80
# Timeout Postgres theo tiến trình (ms): mặc định 30000 / 60000 (app/db/engine.py); compose đặt
# giá trị dài hơn cho jobs/worker. Chỉ cần đặt ở đây khi chạy tiến trình ngoài container.
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# ---- Kết nối cho tiến trình chạy NGOÀI container (uv run …, cần docker-compose.dev.yml mở cổng);
# trong compose các biến này bị ghi đè bằng tên service + secret ở trên. ----
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/scrapebooking
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/scrapebooking_test
REDIS_URL=redis://:devredis@localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=raw-html
# Một hoặc nhiều proxy (cách nhau dấu phẩy, dùng xoay vòng; nên có ≥2 nhà cung cấp). Dạng
# host:port:user:pass của nhà cung cấp viết thành http://user:pass@host:port
PROXY_URL_TEMPLATE=http://USER-country-{country}-session-{session}:PASS@proxy.example.com:7777
SESSION_MAX_AGE_MINUTES=20
SESSION_MAX_REQUESTS=400
REQUEST_MIN_INTERVAL_SECONDS=2.0
REQUEST_JITTER_SECONDS=1.0
PAGE_DROPDOWN_CAP=10
RUN_DEADLINE_MINUTES=90
DEFAULT_ADULTS=2

# Đa kênh: tiền tệ quét cố định (không quy đổi), kênh của tiến trình worker (docker compose đặt
# sẵn theo service), ngân sách request/phút toàn hệ thống theo kênh, tự ngắt kênh khi bị chặn.
SCAN_CURRENCY=VND
WORKER_CHANNEL=booking
CHANNEL_BUDGETS=booking=40,agoda=30,ivivu=20,tripcom=30,mytour=20
CHANNEL_BUDGET_DEFAULT_PER_MINUTE=40
CHANNEL_BLOCK_RATE_THRESHOLD=0.2
CHANNEL_BLOCK_MIN_PROBES=20
CHANNEL_PAUSE_MINUTES=30
# Listing chỉ thành `broken` sau N lần kênh báo "không tồn tại" liên tiếp (404 thật / mã riêng);
# trang challenge trả 200 không giết listing.
LISTING_NOT_FOUND_THRESHOLD=3
# Khoá tĩnh trong JS web của kênh (không phải bí mật tài khoản), mặc định trong app/config.py.
# Kênh deploy bản mới có thể đổi: Mytour trả mã 3004 → probe BLOCKED "mytour_secret_rotated"
# (kênh tự ngắt + email vận hành); tìm khoá mới bằng grep "appHash" trong _app-*.js rồi đặt ở đây.
# Bỏ comment khi cần ghi đè (để trống = chuỗi rỗng, không phải mặc định).
#MYTOUR_WEB_SECRET=
#AGODA_INITIATOR_API_KEY=
#AGODA_INITIATOR_VERSION=6_0
# Quét theo tầng: 0–14 đêm mọi lượt; tới 60 đêm quét lại khi dữ liệu cũ hơn 20h; xa hơn: 66h.
TIER_NEAR_DAYS=14
TIER_MID_DAYS=60
TIER_MID_MAX_AGE_HOURS=20
TIER_FAR_MAX_AGE_HOURS=66
METRICS_PORT=9100
LOG_LEVEL=INFO
PLAYWRIGHT_HEADLESS=true

# Analytics (giai đoạn 2)
LOW_STOCK_THRESHOLD=3
PRICE_CHANGE_THRESHOLD_PCT=3.0

# API (giai đoạn 2)
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
API_PORT=8000
GRAFANA_URL=http://localhost:3001

# Trang giới thiệu (dashboard, route /): kênh liên hệ cho khách vãng lai, đọc lúc chạy.
# Kênh để trống sẽ không hiện. CONTACT_ZALO nhận số điện thoại hoặc link zalo.me đầy đủ.
CONTACT_PHONE=
CONTACT_ZALO=
CONTACT_EMAIL=

# AI insight (giai đoạn 3) — OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_APP_NAME=scrapebooking-insight
OPENROUTER_SITE_URL=

# Thẻ thời tiết Terminal+ (OpenWeather, gói miễn phí). Để trống thì thẻ báo cần cấu hình.
OPENWEATHER_API_KEY=
INSIGHT_USE_BATCH=true

# Thông báo email (cảnh báo đối thủ, bản tin sáng, báo cáo tuần). Để trống SMTP_HOST thì
# không gửi, nhật ký ghi "chưa cấu hình máy chủ email".
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ScrapeBooking <no-reply@example.vn>
SMTP_SECURITY=starttls
# Gốc dashboard cho liên kết trong email
APP_BASE_URL=http://localhost:3000
# Email nhận cảnh báo vận hành (proxy hỏng, kênh bị chặn, lượt quét rỗng), cách nhau dấu phẩy.
# Alertmanager (docker-compose.monitoring.yml) cũng gửi tới đây qua SMTP_* (STARTTLS).
OPS_ALERT_EMAILS=

# Backup (giai đoạn 5): pg_dump -Fc | gzip → bucket, giữ BACKUP_KEEP bản. Mặc định lên MinIO cùng máy;
# đích offsite (B2/Wasabi/S3) khi có BACKUP_ENDPOINT/BACKUP_ACCESS_KEY/BACKUP_SECRET_KEY (xem
# docs/operations.md §8).
BACKUP_BUCKET=pg-backups
BACKUP_KEEP=14
