# syntax=docker/dockerfile:1
#
# Hai target (build context = thư mục gốc repo, xem .dockerignore):
#   base      api, scheduler, jobs, migrate — không Chromium, chạy user `app` (uid 10001),
#             có pg_dump 16 cho backup.
#   collector base + Playwright Chromium (+ thư viện hệ thống) cho 5 worker thu dữ liệu.
# `docker build` không -target (CI) → stage cuối = collector.
#
# Nâng cấp: đổi PYTHON_IMAGE / UV_IMAGE (uv lock revision 3 cần uv ≥ 0.8).

ARG PYTHON_IMAGE=python:3.12.11-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.8.17

FROM ${UV_IMAGE} AS uv

# ---------------------------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH"

# curl: healthcheck api (compose) + tải khoá apt PGDG; postgresql-client-16: pg_dump cho backup
# (cùng major với image postgres trong compose); gzip có sẵn trong debian-slim.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
       -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
       > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends postgresql-client-16 \
    && apt-get purge -y gnupg && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --home-dir /home/app --shell /usr/sbin/nologin app

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app
# Cài dependency trước (cache theo lock), copy mã nguồn sau.
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project
COPY --chown=app:app backend/ ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

USER app
CMD ["python", "-m", "app.scheduler"]

# ---------------------------------------------------------------------------------------------
FROM base AS collector

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

USER root
RUN playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chmod -R a+rX /ms-playwright

# Vẫn chạy root (khác `base`): Chromium cần sandbox namespace, bị seccomp mặc định của Docker chặn
# với user thường, và mã collector gọi `chromium.launch()` không có `--no-sandbox` (Playwright chỉ tự
# thêm cờ này khi là root). Chuyển sang `app` khi collector thêm `--no-sandbox` vào args launch hoặc
# compose gắn seccomp profile của Playwright (xem docs/operations.md §1).
CMD ["arq", "app.worker.settings.WorkerSettings"]
